FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
ARG INSTALL_OCR=false
RUN if [ "$INSTALL_OCR" = "true" ]; then apt-get update && apt-get install -y --no-install-recommends ocrmypdf tesseract-ocr-chi-sim && rm -rf /var/lib/apt/lists/*; fi
COPY backend /app
RUN useradd -u 10001 -m knowledge && mkdir -p /data && chown knowledge:knowledge /data
USER knowledge
ENV APP_ENV=production APP_HOST=0.0.0.0 APP_AUTH_ENABLED=true APP_SECURITY_DIR=/data/security APP_UPLOAD_DIR=/data/uploads DATABASE_URL=sqlite:////data/knowledge_base.db
EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--no-access-log"]
