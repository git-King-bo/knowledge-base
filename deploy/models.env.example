# Full /chat/completions and /embeddings URLs are normalized to base URLs.
AGENT_DEFAULT_MODEL=qwen3.8
AGENT_DEFAULT_API_URL=http://192.168.0.186:8000/v1/chat/completions
AGENT_DEFAULT_API_KEY=
AGENT_EMBEDDING_MODEL=bge-m3
