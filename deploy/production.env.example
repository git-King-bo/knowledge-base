APP_ENV=production
APP_AUTH_ENABLED=true
# 启动时优先 MySQL，连接失败回退 SQLite；运行中不会自动切换。
# sqlite 强制本地库；mysql 强制远端库且连接失败时拒绝启动。
APP_DATABASE_MODE=auto
APP_SQLITE_FALLBACK_URL=sqlite:////data/knowledge_base.db
XINIU_MYSQL_HOST=
XINIU_MYSQL_PORT=3306
XINIU_MYSQL_DATABASE=
XINIU_MYSQL_USER=
XINIU_MYSQL_PASSWORD=
APP_MYSQL_CONNECT_TIMEOUT=5
# REQUIRED: exact approved model domains; no wildcard. Private models require an explicit exception.
APP_PROVIDER_ALLOWED_HOSTS=your-model-provider.example
APP_ALLOW_PRIVATE_PROVIDERS=false
# Optional Fernet key; if blank a private key is generated under /data/security.
APP_ENCRYPTION_KEY=
APP_CORS_ORIGINS=https://knowledge.example.com
APP_MODEL_CONCURRENCY=4
APP_MODEL_REQUESTS_PER_DAY=200
APP_DAILY_TOKEN_BUDGET=2000000
APP_MAX_PENDING_JOBS=20
APP_MAX_OUTPUT_TOKENS=2048
AGENT_DEFAULT_API_URL=
AGENT_DEFAULT_API_KEY=
AGENT_DEFAULT_MODEL=qwen-plus
AGENT_EMBEDDING_API_URL=
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=text-embedding-v1
