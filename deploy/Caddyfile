{$SITE_ADDRESS:localhost} {
    encode zstd gzip
    handle /api/* {
        reverse_proxy backend:8001 {
            flush_interval -1
        }
    }
    handle /health { reverse_proxy backend:8001 }
    handle /ready { reverse_proxy backend:8001 }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
}
