APP_PORT=8001
APP_UPLOAD_DIR=storage/uploads
APP_KB_CHUNK_MAX_CHARS=480
APP_KB_CHUNK_OVERLAP_CHARS=80

# Chat / answer model config
AGENT_DEFAULT_API_URL=https://your-openai-compatible-endpoint/v1
AGENT_DEFAULT_API_KEY=your-api-key
AGENT_DEFAULT_MODEL=qwen-plus

# Embedding model config for hybrid retrieval
AGENT_EMBEDDING_API_URL=https://your-openai-compatible-embedding-endpoint/v1
AGENT_EMBEDDING_API_KEY=your-embedding-api-key
AGENT_EMBEDDING_MODEL=text-embedding-v3
APP_KB_EMBEDDING_BATCH_SIZE=16
APP_KB_HYBRID_LEXICAL_WEIGHT=0.45
APP_KB_HYBRID_EMBEDDING_WEIGHT=0.55

# Optional web search augmentation. Tavily has a free tier; keep the real key only in local .env.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=your-web-search-api-key
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_AUTO_THRESHOLD=0.35
